# Copy this file to .env and fill in your values. Never commit .env.

# OpenAI API key (used in 02_data_cleaning.ipynb to enrich tracks with theme/language labels)
OPENAI_API_KEY=sk-...

# Spotify API credentials (optional, needed to re-pull audio features)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Override default data directory (defaults to ./data/processed/)
SPOTIFY_DATA_DIR=./data/processed/
